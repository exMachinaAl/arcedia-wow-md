# =============================================================
# WORLD OF WA (WOW) — v3.0.0 Stage 1: contoh konfigurasi resmi
# Disusun berdasarkan source v3.0.0, bukan template generik.
# JANGAN menimpa .env Anda jika sudah ada data/sesi sendiri.
# Copy ke .env hanya untuk instalasi baru, lalu edit seperlunya.
# =============================================================

# WhatsApp Group: hanya string 'true' mengaktifkan grup.
# Bot tidak otomatis membalas SEMUA chat grup ketika ON;
# .admin chat global on + .wowchat enable/mode mirror +
# .chatstyle on (pemain melalui DM) juga diperlukan.
WA_ENABLE_GROUPS=true

# Filter JID untuk incoming message.
# Kosong = seluruh pengirim/grup bisa masuk ke handler.
# Untuk uji awal: KOSONGKAN agar DM admin tidak ikut terblokir.
# Bila diisi, pisahkan koma. Sertakan JID admin dan JID grup.
# Contoh (JANGAN salin placeholder):
# WA_ALLOWED_JIDS=6281234567890@s.whatsapp.net,120363012345678901@g.us
WA_ALLOWED_JIDS=

# ID akun Admin WOW, hasil command .whoami via DM (JANGAN pakai nama).
# Lebih mudah: jalankan SETUP-WOW-ADMIN.bat, lalu restart bot.
# Bisa satu atau lebih ID, dipisahkan dengan koma.
# Contoh: WOW_ADMIN_IDS=6281234567890@s.whatsapp.net
# Atau: WOW_ADMIN_IDS=123456789012345@lid
WOW_ADMIN_IDS=

# Direktori sesi Baileys; biarkan sama dengan instalasi sebelumnya.
WA_SESSION_DIR=./data/wa-auth

# Database V, game, guild, chat policy, dan antrian.
# PENTING: jangan ganti path jika Anda sudah memiliki DB yang aktif.
WA_DB_PATH=./data/world.sqlite

# Developer API keys: lokal saja, jangan disajikan lewat web.
WA_DEV_KEYS_PATH=./data/dev-keys.json

# AI lokal Ollama; 0=OFF, 1=ON.
WA_AI_ENABLED=0
WA_AI_MODEL=llama3.2:3b
WA_AI_URL=http://127.0.0.1:11434

# Dashboard: src/server.js membaca process.env HOST dan PORT.
# Catatan v3.0.0: start-dashboard.bat TIDAK otomatis load .env.
# Jadi dua variabel ini perlu diset sebagai environment OS atau
# jalankan dashboard dengan node --env-file=.env (lihat panduan).
# HOST=127.0.0.1
# PORT=3000

# TIDAK ADA variabel WOW_AUCTION_ENABLED untuk v3.0.0.
# Auction, transfer, arcade_spend_limit, arcade_win_limit,
# dailyshop_limit, transfer_max, transfer_daily_limit, dll
# dikendalikan Admin WOW via .admin show / .admin set ...
# dan disimpan di SQLite, bukan di .env.
# Chat Identity global ON/OFF juga diatur via DM:
# .admin chat global on | off
# Settings per grup: .wowchat enable | mode mirror
# Persetujuan pemain via DM: .chatstyle on
